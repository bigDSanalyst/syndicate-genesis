# OPTIONAL: PQC implementation verification for syndicates doing post-quantum research.
# Off by default. Enable by removing the leading dot-underscore or renaming this file
# to pq-verify.yml, then commit. Requires: build artifacts (a compiled .so) or runs the
# NIST ACVP suites standalone.
name: pq-verify
on:
  workflow_dispatch:
    inputs:
      library:
        description: "path to compiled .so containing the NTT to audit"
        required: false
      symbol:
        description: "exported NTT symbol (nm -D lib.so | grep -i ntt)"
        required: false
jobs:
  verify:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1  # v7.0.1
      - uses: actions/setup-python@5fda3b95a4ea91299a34e894583c3862153e4b97  # v7.0.0
        with:
          # Every workflow in this repository runs 3.12, and a guard in the
          # smoke suite keeps them agreeing. One workflow on its own Python is
          # a difference nobody chose, discovered the day it behaves unlike
          # the other six.
          #
          # HISTORY, because this pin used to be load-bearing for a different
          # reason and the reason expired. pq-verify 2.6.7 declared
          # requires-python >=3.8 while pq_verify/core.py used f-strings with
          # escapes inside the expression part - legal only from 3.12 (PEP
          # 701) - so pip installed it happily on 3.8-3.11 and the import then
          # raised SyntaxError. That was measured on 2026-09-18 and is fixed
          # upstream: 2.8.0 declares >=3.9 and its package and tests both parse
          # against the 3.9 grammar, re-measured 2026-09-20. The pin stays at
          # 3.12 for the consistency reason above, not for the old one.
          python-version: "3.12"
      - run: pip install "pq-verify[full]"
      - name: run verification
        run: |
          if [ -n "${{ github.event.inputs.library }}" ]; then
            pq-verify --audit-so "${{ github.event.inputs.library }}" "${{ github.event.inputs.symbol }}" --fail-on-finding
          else
            pq-verify --acvp-all
          fi
